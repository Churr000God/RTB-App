# ==========================================
# RTB Sistema - Variables de Entorno
# ==========================================
# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env real a control de versiones

# --- Supabase ---
# URL del proyecto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública (Settings > API > anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave de servicio (Settings > API > service_role key)
# SOLO se usa en el servidor, NUNCA exponerla al cliente
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Mapbox (ubicación geográfica de entidades y ubicaciones internas) ---
# Token secreto (sk.), de mapbox.com — SOLO se usa en el servidor, para
# geocodificación (Geocoding v6). NUNCA exponerlo al cliente.
MAPBOX_TOKEN=sk...

# Token público (pk.), de mapbox.com — se entrega al cliente vía
# GET /api/mapa/config (tras autenticación), para dibujar el mapa con
# mapbox-gl. Sin estas dos variables, el mapa muestra un aviso en vez de
# romper el formulario (ver db/procesos/direcciones-y-mapa.md).
MAPBOX_PUBLIC_TOKEN=pk...
