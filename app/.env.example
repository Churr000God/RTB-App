# ==========================================
# RTB Sistema - Variables de Entorno
# ==========================================
# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env real a control de versiones

# --- Supabase ---
# URL del proyecto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública (Settings > API > anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave de servicio (Settings > API > service_role key)
# SOLO se usa en el servidor, NUNCA exponerla al cliente
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Mapbox (ubicación geográfica de entidades y ubicaciones internas) ---
# Token secreto (sk.), de mapbox.com — SOLO se usa en el servidor, para
# geocodificación (Geocoding v6). NUNCA exponerlo al cliente.
MAPBOX_TOKEN=sk...

# Token público (pk.), de mapbox.com — se entrega al cliente vía
# GET /api/mapa/config (tras autenticación), para dibujar el mapa con
# mapbox-gl. Sin estas dos variables, el mapa muestra un aviso en vez de
# romper el formulario (ver db/procesos/direcciones-y-mapa.md).
MAPBOX_PUBLIC_TOKEN=pk...

# --- MailerSend (envío de cotizaciones por correo al cliente, RTB-VEN-01) ---
# API key de mailersend.com > Integrations > API tokens. SOLO servidor,
# NUNCA exponerla al cliente. Sin esta variable, "Enviar por correo" queda
# deshabilitado con un aviso en vez de fallar en silencio
# (app/lib/ventas/mailersend.ts).
MAILERSEND_API_KEY=mlsn....

# Remitente: DEBE pertenecer a un dominio verificado en MailerSend, si no la
# API responde 422 "The from.email must be verified".
MAILERSEND_FROM_EMAIL=cotizaciones@tudominio.com
MAILERSEND_FROM_NAME=RTB Refacciones

# Opcional. Si se deja vacío, el reply-to de cada correo se arma con el
# correo del vendedor que dispara el envío, para que el cliente responda
# directo a la persona que cotizó.
MAILERSEND_REPLY_TO=

# --- Chromium headless (generación de PDF de cotizaciones) ---
# El Dockerfile ya lo fija en los stages dev/runner (apk add chromium).
# Documentado aquí sólo por si alguna vez se corre la app fuera de Docker.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
